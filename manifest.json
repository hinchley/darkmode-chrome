{
  "manifest_version": 3,
  "name": "Poor Mans Dark Mode",
  "version": "1.0.0",
  "icons": {
    "16": "icons/sun-dark-16.png",
    "32": "icons/sun-dark-32.png",
    "48": "icons/sun-dark-48.png",
    "128": "icons/sun-dark-128.png"
  },
  "background": {
    "service_worker": "main.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/sun-dark-16.png",
      "32": "icons/sun-dark-32.png"
    },
    "default_title": "Dark Mode"
  },
  "permissions": [
    "scripting",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
